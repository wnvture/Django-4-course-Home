# Defaults are suitable for development on your own computer.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Development generates a local ignored key automatically.
# Set a new random key explicitly before using DJANGO_DEBUG=False.
# DJANGO_SECRET_KEY=

# Leave unset to use SQLite. PostgreSQL example (replace credentials):
# DATABASE_URL=postgresql://home:replace-me@127.0.0.1:5432/home
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
